---
import type { ProjectStatus } from '../data/projects';
import { statusLabelKey } from '../data/projects';
import { t } from '../i18n/ui';

interface Props {
  status: ProjectStatus;
  class?: string;
}
const { status, class: className = '' } = Astro.props;

/** Colore del punto luminoso per stato (il testo resta sempre bianco per il contrasto). */
const color: Record<ProjectStatus, string> = {
  'in-progettazione': 'text-violet-soft',
  'in-sviluppo': 'text-primary-soft',
  'demo-disponibile': 'text-cyan',
  pubblicato: 'text-emerald-300',
};
---

<span class:list={['badge badge-dot', color[status], className]}>
  <span class="text-ink">{t(statusLabelKey(status))}</span>
</span>
