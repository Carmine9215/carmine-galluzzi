---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { navigation, site } from '../config/site';
import { t, type UIKey } from '../i18n/ui';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const label = (key: string) => t(`nav.${key}` as UIKey);
---

<header id="site-header" class="site-header sticky top-0 z-50" data-scrolled="false" data-menu="closed">
  <div class="container-x grid h-[4.5rem] grid-cols-[1fr_auto] items-center gap-4 lg:grid-cols-[1fr_auto_1fr]">
    <!-- Marchio: CG. | Carmine Galluzzi -->
    <a href="/" class="group flex items-center gap-3 justify-self-start rounded-xl" aria-label={`${site.name} — Home`}>
      <Logo size={38} class="shrink-0 transition-transform duration-300 group-hover:-rotate-6" />
      <span class="hidden h-5 w-px bg-line-strong min-[360px]:block" aria-hidden="true"></span>
      <span class="hidden font-display text-[1.02rem] font-bold tracking-tight text-ink min-[360px]:block">{site.name}</span>
    </a>

    <!-- Navigazione desktop, al centro -->
    <nav aria-label={t('nav.main')} class="hidden lg:block">
      <ul class="flex items-center gap-1 rounded-full border border-line bg-bg-2/60 p-1">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="nav-link relative block rounded-full px-4 py-2 text-[0.9rem] font-medium text-muted transition-colors hover:text-ink aria-[current=page]:bg-white/[0.07] aria-[current=page]:text-ink"
              >
                {label(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 justify-self-end">
      <a href="/contatti/" class="btn btn-primary btn-sm hidden sm:inline-flex">
        {t('nav.start')}
        <Icon name="arrow-right" size={16} />
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="menu-toggle relative inline-grid h-11 w-11 place-items-center rounded-full border border-line-strong bg-bg-2/70 text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={t('nav.open')}
        data-label-close={t('nav.close')}
      >
        <span class="sr-only" data-menu-label>{t('nav.open')}</span>
        <span class="menu-bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

</header>

<!-- Menu mobile: pannello a tutto schermo sotto l'header, mai sovrapposto al contenuto visibile -->
<div id="mobile-menu" class="mobile-menu lg:hidden">
  <nav aria-label={t('nav.main')} class="container-x flex h-full flex-col py-8">
    <ul class="flex flex-col">
      {
        navigation.map((item, i) => (
          <li class="menu-item border-b border-line" style={`--i:${i}`}>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="flex min-h-16 items-center justify-between font-display text-[1.75rem] font-bold tracking-tight text-muted transition-colors hover:text-ink aria-[current=page]:text-ink"
            >
              {label(item.key)}
              <Icon name="arrow-up-right" size={22} class="text-cyan" />
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/contatti/" class="menu-item btn btn-primary btn-lg mt-auto w-full" style="--i:6">
      {t('nav.start')}
      <Icon name="arrow-right" size={18} />
    </a>
  </nav>
</div>

<style>
  .site-header {
    background: rgb(6 11 22 / 0.55);
    backdrop-filter: blur(14px) saturate(150%);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease;
  }
  .site-header[data-scrolled='true'],
  .site-header[data-menu='open'] {
    background: rgb(6 11 22 / 0.86);
    border-bottom-color: var(--color-line);
  }

  /* Indicatore della pagina corrente */
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--color-cyan);
    box-shadow: 0 0 8px var(--color-cyan);
    translate: -50% 0;
  }

  /* Icona hamburger → X */
  .menu-bars {
    position: relative;
    width: 18px;
    height: 10px;
  }
  .menu-bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.75px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.35s var(--ease-out-soft),
      top 0.35s var(--ease-out-soft);
  }
  .menu-bars span:first-child {
    top: 0;
  }
  .menu-bars span:last-child {
    top: 8px;
  }
  .menu-toggle[aria-expanded='true'] .menu-bars span:first-child {
    top: 4px;
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-bars span:last-child {
    top: 4px;
    transform: rotate(-45deg);
  }

  /* Pannello mobile */
  .mobile-menu {
    position: fixed;
    inset: 4.5rem 0 0 0;
    z-index: 40;
    overflow-y: auto;
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.3s ease,
      transform 0.35s var(--ease-out-soft),
      visibility 0s linear 0.35s;
  }
  /* Il pannello è fratello dell'header: un antenato con backdrop-filter romperebbe position: fixed */
  .site-header[data-menu='open'] ~ .mobile-menu {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  .menu-item {
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity 0.35s ease,
      translate 0.4s var(--ease-out-soft);
  }
  .site-header[data-menu='open'] ~ .mobile-menu .menu-item {
    opacity: 1;
    translate: none;
    transition-delay: calc(60ms + var(--i, 0) * 40ms);
  }

  /* Senza JavaScript il menu mobile resta disponibile come elenco in pagina */
  :global(html:not(.js)) .mobile-menu {
    position: static;
    visibility: visible;
    opacity: 1;
    transform: none;
    background: transparent;
  }
  :global(html:not(.js)) .menu-item {
    opacity: 1;
    translate: none;
  }
  :global(html:not(.js)) .menu-toggle {
    display: none;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (header) {
    const onScroll = () => header.setAttribute('data-scrolled', String(window.scrollY > 8));
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (header && toggle && menu) {
    const label = toggle.querySelector<HTMLElement>('[data-menu-label]');
    const desktop = window.matchMedia('(min-width: 1024px)');
    // Con il menu aperto il contenuto sottostante non è raggiungibile da tastiera/lettori di schermo
    const background = [document.getElementById('contenuto'), document.querySelector<HTMLElement>('body > footer')];

    const setOpen = (open: boolean, restoreFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.setAttribute('data-menu', open ? 'open' : 'closed');
      background.forEach((el) => el?.toggleAttribute('inert', open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (label) label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
      if (open) window.setTimeout(() => menu.querySelector<HTMLElement>('a')?.focus(), 60);
      else if (restoreFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false, true);
    });
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
