---
/**
 * Metadati SEO, Open Graph, Twitter/X Card, canonical e JSON-LD.
 * Gli URL assoluti vengono generati SOLO se il dominio è configurato
 * (vedi astro.config.mjs): mai indirizzi di esempio.
 */
import { site } from '../config/site';

export interface SEOProps {
  title: string;
  description: string;
  /** Se true il titolo non riceve il suffisso " | Carmine Galluzzi" */
  rawTitle?: boolean;
  image?: { src: string; width: number; height: number; alt: string; type?: string };
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  rawTitle = false,
  image = site.ogImage,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props as SEOProps;

const fullTitle = rawTitle ? title : `${title} | ${site.name}`;
const siteUrl = Astro.site;
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;
const imageUrl = siteUrl ? new URL(image.src, siteUrl).href : undefined;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
/** Serializzazione sicura del JSON-LD: impedisce la chiusura anticipata del tag <script>. */
const safeJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
{canonical && !noindex && <link rel="canonical" href={canonical} />}
{canonical && !noindex && <link rel="alternate" hreflang="it" href={canonical} />}
{canonical && !noindex && <link rel="alternate" hreflang="x-default" href={canonical} />}

<!-- Open Graph: usato da Facebook, LinkedIn e WhatsApp per l'anteprima dei link -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{
  imageUrl && (
    <>
      <meta property="og:image" content={imageUrl} />
      <meta property="og:image:secure_url" content={imageUrl} />
      {image.type && <meta property="og:image:type" content={image.type} />}
      <meta property="og:image:width" content={String(image.width)} />
      <meta property="og:image:height" content={String(image.height)} />
      <meta property="og:image:alt" content={image.alt} />
    </>
  )
}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
{imageUrl && <meta name="twitter:image:alt" content={image.alt} />}

{jsonLdList.map((data) => <script type="application/ld+json" set:html={safeJson(data)} />)}
