---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  id?: string;
}
const { eyebrow, title, intro, align = 'left', id } = Astro.props;
const centered = align === 'center';
---

<div class:list={['reveal max-w-2xl', centered && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="h-section mt-5 text-ink">{title}</h2>
  {intro && <p class="lead mt-5">{intro}</p>}
  <slot />
</div>
