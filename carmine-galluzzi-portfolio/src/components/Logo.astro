---
/**
 * Marchio definitivo "CG" — monogramma con orbite e simbolo </>.
 * Usato in header, footer e nelle aree segnaposto della fotografia.
 * Il file sorgente è in public/brand/ (logo-mark = solo monogramma, logo-carmine-galluzzi = logo completo).
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className = '' } = Astro.props;
---

<img
  src="/brand/logo-mark.webp"
  width={size}
  height={size}
  alt=""
  aria-hidden="true"
  decoding="async"
  class:list={['rounded-[27%] ring-1 ring-white/10', className]}
/>
