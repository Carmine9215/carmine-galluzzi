---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Icon from '../../components/Icon.astro';
import {
  getVisibleProjects,
  getRelatedProjects,
  categoryLabelKey,
  categoryToService,
  statusLabelKey,
  type Project,
} from '../../data/projects';
import { t } from '../../i18n/ui';

export const getStaticPaths = (() => {
  return getVisibleProjects().map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const related = getRelatedProjects(project, 2);
const category = t(categoryLabelKey(project.category));
// Le funzionalità sono "previste" finché il progetto non è pubblicato o in demo: nessuna funzionalità spacciata per già implementata.
const isLive = project.status === 'pubblicato' || project.status === 'demo-disponibile';
const featuresTitle = isLive ? 'Funzionalità principali' : 'Funzionalità principali previste';
const statusNote: Record<typeof project.status, string> = {
  'in-progettazione': 'Il progetto è in fase di analisi e progettazione: funzionalità e architettura sono in definizione.',
  'in-sviluppo': 'Il progetto è in fase di sviluppo: le funzionalità vengono realizzate per rilasci progressivi.',
  'demo-disponibile': 'È disponibile una versione dimostrativa del progetto.',
  pubblicato: 'Il progetto è online e accessibile al pubblico.',
};
const similarHref = `/contatti/?servizio=${categoryToService[project.category]}`;
const siteUrl = Astro.site;

const breadcrumbLd = siteUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteUrl).href },
        { '@type': 'ListItem', position: 2, name: 'Portfolio', item: new URL('/portfolio/', siteUrl).href },
        {
          '@type': 'ListItem',
          position: 3,
          name: project.name,
          item: new URL(`/portfolio/${project.slug}/`, siteUrl).href,
        },
      ],
    }
  : undefined;
---

<BaseLayout
  title={`${project.name} — ${category}`}
  description={`${project.name}: ${project.shortDescription.replace(/\.$/, '')}. Stato: ${t(statusLabelKey(project.status)).toLowerCase()}. Progetto di Carmine Galluzzi.`}
  image={project.image}
  type="article"
  jsonLd={breadcrumbLd}
>
  <!-- Hero del progetto -->
  <section class="relative overflow-hidden" aria-labelledby="project-title">
    <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
    <div class="glow -left-40 -top-48 h-[34rem] w-[34rem] text-primary/20" aria-hidden="true"></div>
    <div class="container-x relative pb-12 pt-10 sm:pt-14">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Portfolio', href: '/portfolio/' }, { label: project.name }]} />

      <div class="mt-10 grid gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:items-end">
        <div>
          <div class="hero-in flex flex-wrap items-center gap-3">
            <a href={`/portfolio/?categoria=${project.category}`} class="mono text-[0.72rem] font-medium uppercase tracking-[0.14em] text-cyan hover:text-ink">
              {category}
            </a>
            <StatusBadge status={project.status} />
          </div>
          <h1 id="project-title" class="hero-in display-xl mt-6 text-ink" style="--d:80ms">{project.name}</h1>
          <p class="hero-in lead mt-6 max-w-2xl" style="--d:160ms">{project.shortDescription}</p>
        </div>
        <div class="hero-in flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-stretch" style="--d:240ms">
          {project.demoUrl && (
            <a href={project.demoUrl} class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">
              Apri la demo
              <Icon name="external" size={18} />
              <span class="sr-only">(si apre in una nuova scheda)</span>
            </a>
          )}
          {project.publicUrl && (
            <a href={project.publicUrl} class="btn btn-ghost btn-lg" target="_blank" rel="noopener noreferrer">
              Visita il sito
              <Icon name="external" size={18} />
              <span class="sr-only">(si apre in una nuova scheda)</span>
            </a>
          )}
          <a href={similarHref} class:list={['btn btn-lg', project.demoUrl ? 'btn-ghost' : 'btn-primary']}>
            {t('cta.similar')}
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Anteprima principale -->
  <div class="container-x">
    <div class="hero-in overflow-hidden rounded-[1.75rem] border border-line bg-bg-2 shadow-2xl shadow-black/40" style="--d:300ms">
      <div class="aspect-[16/10] w-full sm:aspect-[16/8]">
        <ProjectVisual project={project} eager />
      </div>
    </div>
  </div>

  <!-- Introduzione + scheda -->
  <section class="section" aria-labelledby="intro-title">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_22rem] lg:gap-16">
      <div class="reveal">
        <p class="eyebrow">Introduzione</p>
        <h2 id="intro-title" class="h-section mt-5 text-ink">Presentazione</h2>
        <p class="lead mt-6">{project.fullDescription}</p>

        <h3 class="h-card mt-12 text-ink">Obiettivi</h3>
        <ul class="mt-5 space-y-4">
          {
            project.goals.map((g, i) => (
              <li class="flex gap-4">
                <span class="mono mt-0.5 text-sm text-cyan">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-[1.0625rem] leading-relaxed text-ink/90">{g}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="reveal lg:sticky lg:top-28 lg:self-start" aria-labelledby="sheet-title">
        <div class="card p-7">
          <h2 id="sheet-title" class="sr-only">Scheda del progetto</h2>
          <h3 class="mono text-[0.7rem] font-medium uppercase tracking-[0.14em] text-muted">Stato di avanzamento</h3>
          <StatusBadge status={project.status} class="mt-3" />
          <p class="mt-3 text-sm leading-relaxed text-muted">{statusNote[project.status]}</p>
          <hr class="my-6 border-line" />
          <h3 class="mono text-[0.7rem] font-medium uppercase tracking-[0.14em] text-muted">Categoria</h3>
          <p class="mt-2 font-semibold text-ink">{category}</p>
          <hr class="my-6 border-line" />
          <h3 class="mono text-[0.7rem] font-medium uppercase tracking-[0.14em] text-muted">Tecnologie</h3>
          {
            project.technologies.length > 0 ? (
              <ul class="mt-3 flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <li class="tag">{tech}</li>
                ))}
              </ul>
            ) : (
              <p class="mt-2 text-sm text-muted">Stack tecnologico in fase di definizione.</p>
            )
          }
        </div>
      </aside>
    </div>
  </section>

  <!-- Soluzione -->
  <section class="section relative bg-bg-2/60 pt-[clamp(4rem,3rem+4vw,6.5rem)]" aria-labelledby="solution-title">
    <div class="divider-glow absolute inset-x-0 top-0 opacity-50" aria-hidden="true"></div>
    <div class="container-x">
      <p class="eyebrow reveal">La soluzione</p>
      <h2 id="solution-title" class="h-section reveal mt-5 max-w-3xl text-ink">Dall’esigenza alla soluzione progettata</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        <div class="card reveal p-7 sm:p-9">
          <span class="icon-tile"><Icon name="search" size={22} /></span>
          <h3 class="h-card mt-6 text-ink">Il problema affrontato</h3>
          <p class="mt-3 leading-relaxed text-muted">{project.problem}</p>
        </div>
        <div class="card reveal p-7 sm:p-9">
          <span class="icon-tile"><Icon name="layers" size={22} /></span>
          <h3 class="h-card mt-6 text-ink">La soluzione progettata</h3>
          <p class="mt-3 leading-relaxed text-muted">{project.solution}</p>
        </div>
      </div>

      <!-- Funzionalità -->
      <h3 class="h-card reveal mt-16 text-ink">{featuresTitle}</h3>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          project.features.map((f, i) => (
            <li class="card card-glow reveal flex flex-col gap-4 p-6 sm:p-7">
              <span class="mono text-sm text-muted">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex gap-3 text-[1rem] font-medium leading-relaxed text-ink">
                <Icon name="check" size={20} class="mt-0.5 shrink-0 text-cyan" />
                {f}
              </span>
            </li>
          ))
        }
      </ul>
      {!isLive && <p class="mt-4 text-sm text-muted">Le funzionalità indicate sono previste dal progetto e in fase di realizzazione.</p>}
    </div>
  </section>

  {
    project.gallery && project.gallery.length > 0 && (
      <section class="section" aria-labelledby="gallery-title">
        <div class="container-x">
          <h2 id="gallery-title" class="h-section text-ink">Galleria</h2>
          <ul class="mt-10 grid gap-5 sm:grid-cols-2">
            {project.gallery.map((img) => (
              <li class="overflow-hidden rounded-[1.25rem] border border-line">
                <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" class="h-auto w-full" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="related-title">
        <div class="container-x">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow">Portfolio</p>
              <h2 id="related-title" class="h-section mt-5 text-ink">{t('project.related')}</h2>
            </div>
            <a href="/portfolio/" class="btn btn-ghost self-start sm:self-auto">
              {t('cta.allProjects')}
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
          <div class="mt-12 grid gap-6 md:grid-cols-2">
            {related.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBanner
    title={`Vuoi realizzare un progetto come ${project.name}?`}
    text="Raccontami la tua idea: analizzeremo insieme funzionalità, tecnologie e tempi di sviluppo."
    buttonLabel={t('cta.similar')}
    href={similarHref}
  />
</BaseLayout>
