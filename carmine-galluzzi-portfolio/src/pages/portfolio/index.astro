---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard, { type CardVariant } from '../../components/ProjectCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getVisibleProjects, projectCategories, filterLabelKey } from '../../data/projects';
import { t } from '../../i18n/ui';

const projects = getVisibleProjects();
const siteUrl = Astro.site;

/**
 * Composizione editoriale (vista "Tutti"): il primo progetto grande in evidenza, il quarto orizzontale,
 * gli altri standard a due colonne. Se i progetti standard restano dispari, l'ultimo diventa orizzontale.
 * Quando si filtra, la griglia passa a una disposizione uniforme.
 */
const variants: CardVariant[] = projects.map((_, i) => (i === 0 ? 'feature' : i === 3 ? 'horizontal' : 'standard'));
if (variants.filter((v) => v === 'standard').length % 2 === 1) variants[variants.lastIndexOf('standard')] = 'horizontal';

const breadcrumbLd = siteUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteUrl).href },
        { '@type': 'ListItem', position: 2, name: 'Portfolio', item: new URL('/portfolio/', siteUrl).href },
      ],
    }
  : undefined;
---

<BaseLayout
  title="Portfolio: piattaforme SaaS, marketplace e servizi digitali"
  description="I progetti di Carmine Galluzzi: piattaforme SaaS, marketplace, portali e servizi digitali per pronto intervento, attività locali, turismo, logistica e stampa 3D."
  jsonLd={breadcrumbLd}
>
  <section class="relative overflow-hidden" aria-labelledby="portfolio-title">
    <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
    <div class="glow -right-40 -top-40 h-[32rem] w-[32rem] text-primary/20" aria-hidden="true"></div>
    <div class="container-x relative pb-12 pt-10 sm:pt-14 lg:pt-16">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Portfolio' }]} />
      <p class="hero-in eyebrow mt-10">{t('projects.eyebrow')}</p>
      <h1 id="portfolio-title" class="hero-in display-lg mt-5 max-w-4xl text-ink" style="--d:80ms">
        {t('projects.title')}
      </h1>
      <p class="hero-in lead mt-6 max-w-2xl" style="--d:160ms">
        {t('projects.subtitle')} Marketplace, piattaforme SaaS e servizi digitali che seguo come fondatore, ognuno con il
        suo stato reale di avanzamento.
      </p>
    </div>
  </section>

  <section class="section pt-2" aria-label="Elenco dei progetti">
    <div class="container-x">
      <div>
        <div role="group" aria-label={t('filter.label')} class="flex flex-wrap gap-2" id="portfolio-filters">
          <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">{t('filter.all')}</button>
          {
            projectCategories.map((c) => (
              <button type="button" class="filter-btn" data-filter={c} aria-pressed="false">
                {t(filterLabelKey(c))}
              </button>
            ))
          }
        </div>
      </div>

      <p id="portfolio-status" class="sr-only" aria-live="polite"></p>

      <ul class="portfolio-grid mt-10 grid gap-6 lg:grid-cols-2" id="portfolio-grid" data-layout="editorial">
        {
          projects.map((p, i) => (
            <li data-category={p.category} data-variant={variants[i]} class:list={[variants[i] !== 'standard' && 'lg:col-span-2']}>
              <ProjectCard project={p} variant={variants[i]} headingLevel="h2" reveal={false} />
            </li>
          ))
        }
      </ul>

      <p id="portfolio-empty" class="card mt-10 p-10 text-center text-muted" hidden>{t('filter.empty')}</p>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .filter-btn {
    min-height: 2.75rem;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    background: rgb(13 21 38 / 0.7);
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .filter-btn:hover {
    color: var(--color-ink);
    border-color: rgb(34 211 238 / 0.45);
  }
  .filter-btn[aria-pressed='true'] {
    color: var(--color-bg);
    background: var(--color-ink);
    border-color: var(--color-ink);
    box-shadow: 0 8px 24px -12px rgb(59 130 246 / 0.7);
  }
  /* Vista filtrata: disposizione uniforme a due colonne */
  .portfolio-grid[data-layout='uniform'] > li {
    grid-column: auto;
  }
  .portfolio-grid[data-layout='uniform'] :global(.project-card) {
    display: flex;
    flex-direction: column;
  }
  .portfolio-grid[data-layout='uniform'] :global(.project-card > div:first-child) {
    aspect-ratio: 16 / 10;
    height: auto;
    min-height: 0;
    border-right: 0;
    border-bottom: 1px solid var(--color-line);
  }
</style>

<script>
  // Filtri leggeri senza framework e senza ricaricare la pagina. Senza JavaScript tutti i progetti restano visibili.
  const group = document.getElementById('portfolio-filters');
  const grid = document.getElementById('portfolio-grid');
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#portfolio-grid > li'));
  const empty = document.getElementById('portfolio-empty');
  const status = document.getElementById('portfolio-status');

  const apply = (filter: string, announce = true) => {
    let visible = 0;
    grid?.setAttribute('data-layout', filter === 'all' ? 'editorial' : 'uniform');
    for (const item of items) {
      const show = filter === 'all' || item.dataset.category === filter;
      item.hidden = !show;
      if (show) {
        // transizione semplice: le card visibili rientrano con una leggera dissolvenza
        item.classList.remove('card-in');
        void item.offsetWidth;
        item.style.animationDelay = `${Math.min(visible, 6) * 45}ms`;
        item.classList.add('card-in');
        visible++;
      }
    }
    if (empty) empty.hidden = visible > 0;
    group?.querySelectorAll<HTMLButtonElement>('button[data-filter]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.filter === filter));
    });
    if (status && announce) {
      status.textContent = visible === 1 ? '1 progetto visualizzato' : `${visible} progetti visualizzati`;
    }
  };

  group?.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
    if (!btn?.dataset.filter) return;
    apply(btn.dataset.filter);
    const url = new URL(window.location.href);
    if (btn.dataset.filter === 'all') url.searchParams.delete('categoria');
    else url.searchParams.set('categoria', btn.dataset.filter);
    history.replaceState(null, '', url);
  });

  // Supporto a /portfolio/?categoria=marketplace
  const initial = new URLSearchParams(window.location.search).get('categoria');
  if (initial && group?.querySelector(`button[data-filter="${CSS.escape(initial)}"]`)) apply(initial, false);
</script>
