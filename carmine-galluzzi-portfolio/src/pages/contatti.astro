---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { getConfiguredContacts } from '../config/site';
import { t } from '../i18n/ui';

const configured = getConfiguredContacts();
const steps = [
  { title: 'Compila il modulo', text: 'Descrivi l’idea, gli obiettivi e, se vuoi, tempistiche e budget indicativo.' },
  { title: 'Analizzo la richiesta', text: 'Leggo con attenzione e ti ricontatto all’indirizzo email indicato.' },
  { title: 'Definiamo il percorso', text: 'Obiettivi, priorità e una proposta personalizzata per il tuo progetto.' },
];
---

<BaseLayout
  title="Contatti — Parliamo del tuo progetto"
  description="Contatta Carmine Galluzzi per lo sviluppo di piattaforme SaaS, marketplace, applicazioni web, soluzioni AI e automazioni. Raccontami il tuo progetto e ricevi una risposta personalizzata."
>
  <section class="relative overflow-hidden" aria-labelledby="contact-title">
    <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
    <div class="glow -left-48 -top-48 h-[36rem] w-[36rem] text-primary/20" aria-hidden="true"></div>
    <div class="glow -right-56 top-1/3 hidden h-[30rem] w-[30rem] text-violet/15 lg:block" aria-hidden="true"></div>

    <div class="container-x relative grid gap-14 pb-24 pt-12 sm:pt-16 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16 lg:pt-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="hero-in eyebrow">Contatti</p>
        <h1 id="contact-title" class="hero-in display-lg mt-6 text-ink" style="--d:80ms">
          {t('contact.title.a')} <span class="text-gradient">{t('contact.title.b')}</span>
        </h1>
        <p class="hero-in lead mt-6 max-w-lg" style="--d:160ms">{t('contact.subtitle')}</p>

        <ol class="hero-in mt-12 space-y-6" style="--d:240ms">
          {
            steps.map((s, i) => (
              <li class="flex gap-5">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-line-strong bg-bg-2 font-mono text-sm text-cyan">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h2 class="font-display text-[1.05rem] font-bold text-ink">{s.title}</h2>
                  <p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>

        {
          configured.length > 0 && (
            <div class="mt-12">
              <h2 class="mono text-[0.7rem] font-medium uppercase tracking-[0.16em] text-muted">Altri canali</h2>
              <ul class="mt-4 flex flex-wrap gap-3">
                {configured.map((c) => (
                  <li>
                    <a href={c.href} class="btn btn-ghost btn-sm" {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                      <Icon name={c.id === 'email' ? 'mail' : c.id} size={18} />
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <div class="hero-in form-shell relative rounded-[2rem] p-px" style="--d:200ms">
        <div class="rounded-[calc(2rem-1px)] bg-bg-2/95 p-6 sm:p-10">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="font-display text-2xl font-bold tracking-tight text-ink">Richiesta di progetto</h2>
            <span class="badge badge-dot text-cyan"><span class="text-ink">Circa 2 minuti</span></span>
          </div>
          <p class="mt-2 text-[0.9375rem] text-muted">I dati inseriti servono solo a rispondere alla tua richiesta.</p>
          <div class="mt-9">
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .form-shell {
    background: linear-gradient(160deg, rgb(59 130 246 / 0.45), rgb(148 163 184 / 0.12) 35%, rgb(139 92 246 / 0.35));
    box-shadow: 0 40px 100px -50px rgb(59 130 246 / 0.55);
  }
</style>
