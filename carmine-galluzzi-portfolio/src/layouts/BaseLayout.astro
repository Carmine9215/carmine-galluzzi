---
import '../styles/global.css';
import SEO, { type SEOProps } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { t } from '../i18n/ui';

type Props = SEOProps;
const seo = Astro.props as Props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060B16" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Font self-hosted: precaricati quelli visibili subito (titolo e testo della hero) -->
    <link rel="preload" href="/fonts/inter-display-700.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff" as="font" type="font/woff" crossorigin />
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
    <SEO {...seo} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#contenuto"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-bg"
    >
      {t('skip.content')}
    </a>
    <Header />
    <main id="contenuto" class="flex-1 focus:outline-none" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
